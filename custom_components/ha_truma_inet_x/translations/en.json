  "services": {
    "write_parameter": {
      "name": "Write parameter",
      "description": "Write any topic parameter to the Truma system (expert function).",
      "fields": {
        "config_entry_id": {
          "name": "Panel",
          "description": "Config entry (optional if only one panel)."
        },
        "topic": {
          "name": "Topic",
          "description": "Topic name, e.g. AirHeating."
        },
        "parameter": {
          "name": "Parameter",
          "description": "Parameter name, e.g. TgtTemp."
        },
        "value": {
          "name": "Value",
          "description": "Raw value (temperatures in 1/10 °C)."
        },
        "device": {
          "name": "Device address",
          "description": "Optional bus address, e.g. 0x0201."
