{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Select Truma iNet X panel",
        "data": {
          "address": "Panel"
        }
      },
      "pair": {
        "title": "Pair {name}",
        "description": "Panel {name} ({address}), advertised pairing state: **{pairing_state}**.\n\n1. Close the Truma iNet X app on all phones (the panel only accepts a limited number of connections).\n2. Put the iNet X panel into pairing mode (panel menu: Settings → Bluetooth / Connections → pair new device).\n3. Enter the 6-digit PIN shown on the panel and submit within the pairing time window.\n\nIf Home Assistant is already bonded with the panel (e.g. via `bluetoothctl`), tick *Already paired*.\n\nLast error detail: {detail}",
        "data": {
          "passkey": "PIN shown on the panel",
          "username": "Name shown on the panel",
          "skip_pairing": "Already paired (skip Bluetooth pairing)"
        },
        "data_description": {
          "passkey": "Leave empty if the panel does not show a PIN."
        }
      }
    },
    "error": {
      "invalid_passkey": "The PIN must consist of up to 6 digits.",
      "passkey_required": "The panel requires a PIN. Enter the PIN shown on the panel.",
      "wrong_passkey": "Pairing was rejected – wrong PIN or pairing mode expired.",
      "pairing_timeout": "Pairing timed out. Is the panel in pairing mode?",
      "pairing_failed": "Bluetooth pairing failed.",
      "agent_failed": "Could not register a Bluetooth pairing agent.",
      "dbus_unavailable": "The Bluetooth stack (BlueZ/D-Bus) is not reachable.",
      "device_not_local": "The panel is not known to the local Bluetooth adapter.",
      "cannot_connect": "Could not connect to the panel.",
      "no_registration": "The panel did not accept the registration (is it paired?)."
    },
    "abort": {
      "already_configured": "Device is already configured",
      "no_devices_found": "No Truma iNet X panel found via Bluetooth."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Truma iNet X options",
        "data": {
          "username": "Name shown on the panel",
          "cmd_notify_characteristic": "Characteristic for transport notifications"
        }
      }
    }
  },
  "selector": {
    "cmd_notify": {
      "options": {
        "auto": "Automatic (FC314001, recommended)",
        "fc314001": "FC314001",
        "fc314004": "FC314004 (like the Android app)"
      }
    }
  },
