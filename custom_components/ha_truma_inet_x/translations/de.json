{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Truma iNet X Panel auswählen",
        "data": {
          "address": "Panel"
        }
      },
      "pair": {
        "title": "{name} koppeln",
        "description": "Panel {name} ({address}), gemeldeter Kopplungsstatus: **{pairing_state}**.\n\n1. Die Truma-iNet-X-App auf allen Handys schließen (das Panel akzeptiert nur wenige gleichzeitige Verbindungen).\n2. Das iNet X Panel in den Kopplungsmodus versetzen (Panel-Menü: Einstellungen → Bluetooth / Verbindungen → neues Gerät koppeln).\n3. Die am Panel angezeigte 6-stellige PIN eingeben und innerhalb des Kopplungszeitfensters absenden.\n\nIst Home Assistant bereits mit dem Panel gekoppelt (z. B. per `bluetoothctl`), *Bereits gekoppelt* anhaken.\n\nLetztes Fehlerdetail: {detail}",
        "data": {
          "passkey": "Am Panel angezeigte PIN",
          "username": "Name, der am Panel angezeigt wird",
          "skip_pairing": "Bereits gekoppelt (Bluetooth-Kopplung überspringen)"
        },
        "data_description": {
          "passkey": "Leer lassen, wenn das Panel keine PIN anzeigt."
        }
      }
    },
    "error": {
      "invalid_passkey": "Die PIN besteht aus bis zu 6 Ziffern.",
      "passkey_required": "Das Panel verlangt eine PIN. Bitte die am Panel angezeigte PIN eingeben.",
      "wrong_passkey": "Kopplung abgelehnt – falsche PIN oder Kopplungsmodus abgelaufen.",
      "pairing_timeout": "Zeitüberschreitung beim Koppeln. Ist das Panel im Kopplungsmodus?",
      "pairing_failed": "Bluetooth-Kopplung fehlgeschlagen.",
      "agent_failed": "Bluetooth-Kopplungsagent konnte nicht registriert werden.",
      "dbus_unavailable": "Der Bluetooth-Stack (BlueZ/D-Bus) ist nicht erreichbar.",
      "device_not_local": "Das Panel ist dem lokalen Bluetooth-Adapter nicht bekannt.",
      "cannot_connect": "Verbindung zum Panel fehlgeschlagen.",
      "no_registration": "Das Panel hat die Anmeldung nicht akzeptiert (gekoppelt?)."
    },
    "abort": {
      "already_configured": "Gerät ist bereits eingerichtet",
      "no_devices_found": "Kein Truma iNet X Panel per Bluetooth gefunden."
    }
  },
